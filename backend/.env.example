# Copy to .env and fill in. Never commit the real .env.

# Supabase (Project Settings -> API). The service role key stays on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-service-role-key

# Postgres via Supabase's connection pooler (works on IPv4 and IPv6 networks).
# If the password contains special characters it is encoded automatically.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Redis for Celery (Upstash: use the rediss:// URL). Local development: redis://localhost:6379/0
REDIS_URL=rediss://default:YOUR-PASSWORD@YOUR-DB.upstash.io:6379?ssl_cert_reqs=required

GEMINI_API_KEY=your-gemini-api-key

# Comma-separated emails that get admin access (must match their Supabase login)
ADMIN_EMAILS=you@example.com

# Website address(es) allowed to call the API, comma-separated (production: your Vercel URL)
CORS_ORIGINS=http://localhost:3000

# Secret for POST /api/jobs/run (production: Render generates it; GitHub Actions sends it).
# Leave empty locally if you run the Celery worker instead.
JOBS_TOKEN=

# Production behind Render's proxy: 1. Local development: 0.
TRUSTED_PROXY_HOPS=0

# Optional tuning (defaults shown)
# COLLECT_INTERVAL_MINUTES=15
# PUBLIC_FETCHES_PER_HOUR=3
# PUBLIC_FETCHES_PER_DAY=50
# PUBLIC_REFETCH_HOURS=6
