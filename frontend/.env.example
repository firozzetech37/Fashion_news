# Copy to .env.local and fill in. On Vercel, set these in Project Settings -> Environment Variables.

# Supabase (Project Settings -> API): the public anon key, safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The TrendScope API (production: your Render URL, e.g. https://trendscope-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000
